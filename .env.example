# Server Port & Host Configuration
# Hugging Face Spaces sets PORT=7860 automatically. Locally defaults to 8006.
PORT=7860
HOST=0.0.0.0

# Kokoro-82M Local CPU Voice (af_bella, af_sarah, am_adam, etc.)
KOKORO_VOICE=af_bella

# Edge-TTS Neural Cloud Voice (hi-IN-SwaraNeural, hi-IN-MadhurNeural, en-IN-NeerjaNeural, etc.)
EDGE_DEFAULT_VOICE=hi-IN-SwaraNeural

# ElevenLabs Studio Voice (Optional - Leave blank if not used)
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_API_KEY_2=

# Legacy Seed
CHATTTS_SEED=2222
